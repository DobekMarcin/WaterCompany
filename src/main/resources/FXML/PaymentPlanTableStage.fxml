<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/20.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="md.program.controller.PaymentPlan.PaymentPlanTableStageController">

    <top>
        <VBox spacing="0.0">
            <children>
                <HBox alignment="CENTER_LEFT" style="-fx-background-color: white;">
                    <children>
                        <VBox>
                            <children>
                                <Label style="-fx-font-size: 16pt; -fx-font-family: 'Segoe UI Semibold'; -fx-text-fill: #2c3e50;" text="Plan Płatności" />
                                <Label style="-fx-text-fill: #7f8c8d; -fx-font-size: 9pt;" text="Zarządzaj harmonogramem i planowanymi wpłatami płatników." />
                            </children>
                        </VBox>

                        <Region HBox.hgrow="ALWAYS" />

                        <HBox alignment="CENTER" spacing="10.0">
                            <children>
                                <CheckBox fx:id="companyFilter" mnemonicParsing="false" text="%payment.filter.company" visible="false" />

                                <Label style="-fx-font-weight: bold;" text="%textfield.year" />
                                <ComboBox fx:id="yearComboBox" onAction="#selectYearOnAction" prefWidth="100.0" />

                                <Label style="-fx-font-weight: bold;" text="%textfield.filter" />
                                <TextField fx:id="filterTextField" prefWidth="300.0" promptText="Szukaj płatnika..." />
                            </children>
                        </HBox>
                    </children>
                    <padding>
                        <Insets bottom="10.0" left="20.0" right="20.0" top="10.0" />
                    </padding>
                </HBox>
                <Separator />
            </children>
        </VBox>
    </top>

    <center>
        <TableView fx:id="paymentTable" tableMenuButtonVisible="true" BorderPane.alignment="CENTER">
            <columns>
                <TableColumn fx:id="idColumn" maxWidth="60.0" minWidth="60.0" prefWidth="60.0" style="-fx-alignment: CENTER-RIGHT;" text="%payment.table.id" />
                <TableColumn fx:id="nameColumn" minWidth="100.0" prefWidth="120.0" text="%payment.table.name" />
                <TableColumn fx:id="surnameColumn" minWidth="120.0" prefWidth="150.0" text="%payment.table.surname" />

                <TableColumn fx:id="m1Column" minWidth="65.0" style="-fx-alignment: CENTER-RIGHT; -fx-background-color: rgba(240,240,240,0.3);" text="%payment.table.m1" />
                <TableColumn fx:id="m2Column" minWidth="65.0" style="-fx-alignment: CENTER-RIGHT;" text="%payment.table.m2" />
                <TableColumn fx:id="m3Column" minWidth="65.0" style="-fx-alignment: CENTER-RIGHT; -fx-background-color: rgba(240,240,240,0.3);" text="%payment.table.m3" />
                <TableColumn fx:id="m4Column" minWidth="65.0" style="-fx-alignment: CENTER-RIGHT;" text="%payment.table.m4" />
                <TableColumn fx:id="m5Column" minWidth="65.0" style="-fx-alignment: CENTER-RIGHT; -fx-background-color: rgba(240,240,240,0.3);" text="%payment.table.m5" />
                <TableColumn fx:id="m6Column" minWidth="65.0" style="-fx-alignment: CENTER-RIGHT;" text="%payment.table.m6" />
                <TableColumn fx:id="m7Column" minWidth="65.0" style="-fx-alignment: CENTER-RIGHT; -fx-background-color: rgba(240,240,240,0.3);" text="%payment.table.m7" />
                <TableColumn fx:id="m8Column" minWidth="65.0" style="-fx-alignment: CENTER-RIGHT;" text="%payment.table.m8" />
                <TableColumn fx:id="m9Column" minWidth="65.0" style="-fx-alignment: CENTER-RIGHT; -fx-background-color: rgba(240,240,240,0.3);" text="%payment.table.m9" />
                <TableColumn fx:id="m10Column" minWidth="65.0" style="-fx-alignment: CENTER-RIGHT;" text="%payment.table.m10" />
                <TableColumn fx:id="m11Column" minWidth="65.0" style="-fx-alignment: CENTER-RIGHT; -fx-background-color: rgba(240,240,240,0.3);" text="%payment.table.m11" />
                <TableColumn fx:id="m12Column" minWidth="65.0" style="-fx-alignment: CENTER-RIGHT;" text="%payment.table.m12" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
            <BorderPane.margin>
                <Insets bottom="10.0" left="15.0" right="15.0" top="15.0" />
            </BorderPane.margin>
        </TableView>
    </center>

    <bottom>
        <VBox>
            <children>
                <Separator />
                <HBox alignment="CENTER_LEFT" spacing="10.0" style="-fx-background-color: #f8f9fa;">
                    <children>
                        <Button mnemonicParsing="false" onAction="#editPaymentPlanOnAction" prefWidth="90.0" text="%partner.table.edit" />
                        <Separator orientation="VERTICAL" />

                        <Button mnemonicParsing="false" onAction="#generatePaymentPlanOnAction" prefWidth="110.0" styleClass="button-success" text="%payment.table.generate" />
                        <Button mnemonicParsing="false" onAction="#generatePaymentPlanOneOnAction" text="%payment.table.generate.one" />

                        <Separator orientation="VERTICAL" />

                        <Button mnemonicParsing="false" onAction="#deletePaymentPlanOnAction" styleClass="button-danger" text="%payment.table.delete.year" />
                        <Button mnemonicParsing="false" onAction="#deletePaymentPlanOneOnAction" styleClass="button-danger-light" text="%payment.table.delete.one" />

                        <Region HBox.hgrow="ALWAYS" />

                        <Button mnemonicParsing="false" onAction="#paymentPlanBillOcAction" prefWidth="120.0" text="%payment.table.print.bill" />
                        <Button mnemonicParsing="false" onAction="#paymentPlanPrintOnAction" prefWidth="110.0" styleClass="button-info" text="%payment.table.print" />
                    </children>
                    <padding>
                        <Insets bottom="12.0" left="20.0" right="20.0" top="12.0" />
                    </padding>
                </HBox>
            </children>
        </VBox>
    </bottom>
</BorderPane>