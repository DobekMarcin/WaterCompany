<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>

<BorderPane maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/20.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="md.program.controller.company.CompanyTableStageController">
    <top>
        <AnchorPane BorderPane.alignment="CENTER">
            <children>
                <TextField fx:id="filterTextField" layoutX="901.0" layoutY="5.0" AnchorPane.bottomAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="5.0" />
                <Label layoutX="1046.0" layoutY="5.0" prefHeight="35.0" prefWidth="63.0" text="%textfield.filter" AnchorPane.bottomAnchor="0.0" AnchorPane.rightAnchor="211.0" AnchorPane.topAnchor="5.0" />
            </children>
            <BorderPane.margin>
                <Insets bottom="5.0" left="10.0" right="10.0" top="5.0" />
            </BorderPane.margin>
        </AnchorPane>
    </top>
    <center>
      <TableView fx:id="companyTable" tableMenuButtonVisible="true" BorderPane.alignment="CENTER">
        <columns>
          <TableColumn id="right" fx:id="idColumn" maxWidth="60.0" minWidth="50.0" prefWidth="60.0" text="%company.id" />
          <TableColumn id="left" fx:id="nameColumn" minWidth="50.0" prefWidth="200.0" text="%company.name" />
            <TableColumn id="left" fx:id="nipColumn" minWidth="50.0" prefWidth="150.0" text="%company.nip" />
            <TableColumn id="left" fx:id="placeColumn" minWidth="120.0" prefWidth="120.0" text="%company.place" />
            <TableColumn id="left" fx:id="postCodeColumn" minWidth="50.0" prefWidth="100.0" text="%company.postcode" />
            <TableColumn id="left" fx:id="postColumn" minWidth="120.0" prefWidth="120.0" text="%company.post" />
            <TableColumn id="left" fx:id="addressColumn" minWidth="50.0" prefWidth="100.0" text="%company.address" />
            <TableColumn id="left" fx:id="phoneColumn" minWidth="50.0" prefWidth="100.0" text="%company.phone" />
            <TableColumn id="left" fx:id="emailColumn" minWidth="50.0" prefWidth="100.0" text="%company.email" />
        </columns>
         <BorderPane.margin>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </BorderPane.margin>
          <columnResizePolicy>
              <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
          </columnResizePolicy>
      </TableView>
   </center>
   <bottom>
      <AnchorPane prefHeight="19.0" prefWidth="580.0" BorderPane.alignment="CENTER">
         <children>
            <Button mnemonicParsing="false" onAction="#addCompanyOnAction" text="%partner.table.add" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" />
            <Button layoutX="200.0" layoutY="7.0" mnemonicParsing="false" onAction="#deleteCompanyOnAction" text="%partner.table.delete" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="200.0" />
            <Button layoutX="98.0" layoutY="7.0" mnemonicParsing="false" onAction="#editCompanyOnAction" text="%partner.table.edit" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="98.0" />
            <Button layoutX="514.0" layoutY="7.0" mnemonicParsing="false" onAction="#printCompanyOnAction" text="%partner.table.print" AnchorPane.bottomAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0" />
         </children>
         <BorderPane.margin>
            <Insets bottom="10.0" left="10.0" right="10.0" />
         </BorderPane.margin>
      </AnchorPane>
   </bottom>
</BorderPane>
