<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" prefHeight="600.0" prefWidth="1000.0" stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/20.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="md.program.controller.company.CompanyTableStageController">

    <top>
        <VBox spacing="0.0">
            <children>
                <HBox alignment="CENTER_LEFT" style="-fx-background-color: white;">
                    <children>
                        <VBox>
                            <children>
                                <Label style="-fx-font-size: 16pt; -fx-font-family: 'Segoe UI Semibold'; -fx-text-fill: #2c3e50;" text="Rejestr Firm" />
                                <Label style="-fx-text-fill: #7f8c8d; -fx-font-size: 9pt;" text="Zarządzanie danymi Twoich firm i oddziałów." />
                            </children>
                        </VBox>

                        <Region HBox.hgrow="ALWAYS" />

                        <HBox alignment="CENTER" spacing="10.0">
                            <children>
                                <Label style="-fx-font-weight: bold;" text="%textfield.filter" />
                                <TextField fx:id="filterTextField" prefWidth="300.0" promptText="Szukaj po nazwie lub NIP..." />
                            </children>
                        </HBox>
                    </children>
                    <padding>
                        <Insets bottom="10.0" left="20.0" right="20.0" top="10.0" />
                    </padding>
                </HBox>
                <Separator />
            </children>
        </VBox>
    </top>

    <center>
        <TableView fx:id="companyTable" tableMenuButtonVisible="true" BorderPane.alignment="CENTER">
            <columns>
                <TableColumn fx:id="idColumn" maxWidth="60.0" minWidth="60.0" prefWidth="60.0" style="-fx-alignment: CENTER-RIGHT;" text="%company.id" />
                <TableColumn fx:id="nameColumn" minWidth="200.0" prefWidth="250.0" text="%company.name" />
                <TableColumn fx:id="nipColumn" minWidth="100.0" prefWidth="110.0" style="-fx-alignment: CENTER;" text="%company.nip" />
                <TableColumn fx:id="phoneColumn" minWidth="100.0" prefWidth="110.0" text="%company.phone" />
                <TableColumn fx:id="emailColumn" minWidth="150.0" prefWidth="180.0" text="%company.email" />
                <TableColumn fx:id="addressColumn" minWidth="150.0" prefWidth="200.0" text="%company.address" />
                <TableColumn fx:id="postCodeColumn" maxWidth="90.0" minWidth="70.0" prefWidth="80.0" style="-fx-alignment: CENTER;" text="%company.postcode" />
                <TableColumn fx:id="placeColumn" minWidth="100.0" prefWidth="120.0" text="%company.place" />
                <TableColumn fx:id="postColumn" minWidth="100.0" prefWidth="120.0" text="%company.post" />
            </columns>
            <BorderPane.margin>
                <Insets bottom="10.0" left="15.0" right="15.0" top="15.0" />
            </BorderPane.margin>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>
    </center>

    <bottom>
        <VBox>
            <children>
                <Separator />
                <HBox alignment="CENTER_LEFT" spacing="10.0" style="-fx-background-color: #f8f9fa;">
                    <children>
                        <Button mnemonicParsing="false" onAction="#addCompanyOnAction" prefWidth="110.0" styleClass="button-success" text="%partner.table.add" />
                        <Button mnemonicParsing="false" onAction="#editCompanyOnAction" prefWidth="110.0" text="%partner.table.edit" />

                        <Separator orientation="VERTICAL" />

                        <Button mnemonicParsing="false" onAction="#deleteCompanyOnAction" prefWidth="110.0" styleClass="button-danger" text="%partner.table.delete" />

                        <Region HBox.hgrow="ALWAYS" />

                        <Button mnemonicParsing="false" onAction="#printCompanyOnAction" prefWidth="120.0" styleClass="button-info" text="%partner.table.print" />
                    </children>
                    <padding>
                        <Insets bottom="12.0" left="20.0" right="20.0" top="12.0" />
                    </padding>
                </HBox>
            </children>
        </VBox>
    </bottom>
</BorderPane>