<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/20.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="md.program.controller.partner.PartnerTableStageController">

    <top>
        <VBox spacing="0.0">
            <children>
                <HBox alignment="CENTER_LEFT" style="-fx-background-color: white;">
                    <children>
                        <VBox>
                            <children>
                                <Label style="-fx-font-size: 16pt; -fx-font-family: 'Segoe UI Semibold'; -fx-text-fill: #2c3e50;" text="Kartoteka Partnerów" />
                                <Label style="-fx-text-fill: #7f8c8d; -fx-font-size: 9pt;" text="Zarządzaj danymi partnerów." />
                            </children>
                        </VBox>
                        <Region HBox.hgrow="ALWAYS" />
                        <HBox alignment="CENTER" spacing="10.0">
                            <children>
                                <Label style="-fx-font-weight: bold;" text="%textfield.filter" />
                                <TextField fx:id="filterTextField" prefWidth="300.0" promptText="Szukaj po nazwisku, NIP lub adresie..." />
                            </children>
                        </HBox>
                    </children>
                    <padding>
                        <Insets bottom="10.0" left="20.0" right="20.0" top="10.0" />
                    </padding>
                </HBox>
                <Separator />
            </children>
        </VBox>
    </top>

    <center>
        <TableView fx:id="partnerTable" tableMenuButtonVisible="true" BorderPane.alignment="CENTER">
            <columns>
                <TableColumn fx:id="idColumnPartnerTable" maxWidth="60.0" minWidth="60.0" prefWidth="60.0" style="-fx-alignment: CENTER-RIGHT;" text="%partner.table.id" />
                <TableColumn fx:id="nameColumnPartnerTable" minWidth="100.0" prefWidth="120.0" text="%partner.table.name" />
                <TableColumn fx:id="surnameColumnPartnerTable" minWidth="120.0" prefWidth="150.0" text="%partner.table.surname" />
                <TableColumn fx:id="addressColumnPartnerTable" minWidth="120.0" prefWidth="150.0" text="%partner.table.address" />
                <TableColumn fx:id="postCodeColumnPartnerTable" maxWidth="80.0" prefWidth="80.0" style="-fx-alignment: CENTER;" text="%partner.table.postCode" />
                <TableColumn fx:id="postColumnPartnerTable" prefWidth="100.0" text="%partner.table.post" />
                <TableColumn fx:id="peopleColumnPartnerTable" maxWidth="70.0" prefWidth="70.0" style="-fx-alignment: CENTER;" text="%partner.table.people" />
                <TableColumn fx:id="companyColumnPartnerTable" prefWidth="100.0" style="-fx-alignment: CENTER;" text="%partner.table.company" />
                <TableColumn fx:id="nipColumnPartnerTable" prefWidth="110.0" style="-fx-alignment: CENTER;" text="%partner.table.nip" />
                <TableColumn fx:id="meterColumnPartnerTable" prefWidth="90.0" style="-fx-alignment: CENTER;" text="%partner.table.meter" />
                <TableColumn fx:id="archiveColumnPartnerTable" prefWidth="80.0" style="-fx-alignment: CENTER;" text="%partner.table.archives" visible="false" />
                <TableColumn fx:id="addDateColumnPartnerTable" prefWidth="100.0" style="-fx-alignment: CENTER;" text="%partner.table.adddata" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
            <BorderPane.margin>
                <Insets bottom="10.0" left="15.0" right="15.0" top="15.0" />
            </BorderPane.margin>
        </TableView>
    </center>

    <bottom>
        <VBox>
            <children>
                <Separator />
                <HBox alignment="CENTER_LEFT" spacing="10.0" style="-fx-background-color: #f8f9fa;">
                    <children>
                        <Button mnemonicParsing="false" onAction="#addPartnerOnAction" prefWidth="90.0" styleClass="button-success" text="%partner.table.add" />
                        <Button mnemonicParsing="false" onAction="#editPartnerOnAction" prefWidth="90.0" text="%partner.table.edit" />

                        <Separator orientation="VERTICAL" />

                        <Button mnemonicParsing="false" onAction="#logPartnerOnAction" prefWidth="100.0" text="Logi" />

                        <Separator orientation="VERTICAL" />

                        <Button mnemonicParsing="false" onAction="#deletePartnerOnAction" prefWidth="90.0" styleClass="button-danger" text="%partner.table.delete" />

                        <Region HBox.hgrow="ALWAYS" />

                        <Button mnemonicParsing="false" onAction="#partnerPrintOnAction" prefWidth="110.0" styleClass="button-info" text="%partner.table.print" />
                    </children>
                    <padding>
                        <Insets bottom="12.0" left="20.0" right="20.0" top="12.0" />
                    </padding>
                </HBox>
            </children>
        </VBox>
    </bottom>
</BorderPane>
