<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>

<BorderPane maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/20.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="md.program.controller.BKAccountList.BKAccountListStageController">
    <top>
        <AnchorPane BorderPane.alignment="CENTER">
            <BorderPane.margin>
                <Insets bottom="5.0" left="10.0" right="10.0" top="5.0" />
            </BorderPane.margin>
         <children>
            <Label text="%textfield.year" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.topAnchor="5.0" />
            <ComboBox fx:id="yearComboBox" onAction="#selectYearOnAction" prefWidth="100.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="44.0" AnchorPane.topAnchor="0.0" />
         </children>
        </AnchorPane>
    </top>
    <center>
      <TableView id="accountTable" fx:id="accountTable" tableMenuButtonVisible="true" BorderPane.alignment="CENTER">
        <columns>
          <TableColumn id="right" fx:id="accountNumberColumn" minWidth="50.0" prefWidth="150.0" text="%bookkeeping.list.account" />
          <TableColumn id="left" fx:id="descriptionAccountColumn" minWidth="100.0" prefWidth="400.0" text="%bookkeeping.list.description" />
            <TableColumn id="left" fx:id="debetAccountColumn" minWidth="50.0" prefWidth="200.0" text="%bookkeeping.list.debit" />
            <TableColumn id="left" fx:id="creditAccountColumn" minWidth="50.0" prefWidth="200.0" text="%bookkeeping.list.credit" />
            <TableColumn fx:id="synColumn" minWidth="150.0" prefWidth="150.0" text="%account.plan.syn" />
        </columns>
         <BorderPane.margin>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </BorderPane.margin>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
      </TableView>
   </center>
   <bottom>
      <AnchorPane prefHeight="19.0" prefWidth="580.0" BorderPane.alignment="CENTER">
         <children>
            <Button mnemonicParsing="false" text="%partner.table.add" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" />
            <Button layoutX="514.0" layoutY="7.0" mnemonicParsing="false" text="%partner.table.print" AnchorPane.bottomAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0" />
         </children>
         <BorderPane.margin>
            <Insets bottom="10.0" left="10.0" right="10.0" />
         </BorderPane.margin>
      </AnchorPane>
   </bottom>
</BorderPane>
