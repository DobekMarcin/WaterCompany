<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/20.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="md.program.controller.invoice.InvoiceTableStageController">

    <top>
        <VBox spacing="0.0">
            <children>
                <HBox alignment="CENTER_LEFT" style="-fx-background-color: white;">
                    <children>
                        <VBox>
                            <children>
                                <Label style="-fx-font-size: 16pt; -fx-font-family: 'Segoe UI Semibold'; -fx-text-fill: #2c3e50;" text="Rejestr Faktur" />
                                <Label style="-fx-text-fill: #7f8c8d; -fx-font-size: 9pt;" text="Ewidencja wystawionych faktur oraz dokumentów księgowych." />
                            </children>
                        </VBox>

                        <Region HBox.hgrow="ALWAYS" />

                        <HBox alignment="CENTER" spacing="10.0">
                            <children>
                                <Label style="-fx-font-weight: bold;" text="%invoice.table.year" />
                                <ComboBox fx:id="yearComboBox" onAction="#selectYearOnAction" prefWidth="100.0" />

                                <Label style="-fx-font-weight: bold;" text="%textfield.filter" />
                                <TextField fx:id="filterTextField" prefWidth="300.0" promptText="Szukaj numeru, firmy lub opisu..." />
                            </children>
                        </HBox>
                    </children>
                    <padding>
                        <Insets bottom="10.0" left="20.0" right="20.0" top="10.0" />
                    </padding>
                </HBox>
                <Separator />
            </children>
        </VBox>
    </top>

    <center>
        <TableView fx:id="invoiceTable" tableMenuButtonVisible="true" BorderPane.alignment="CENTER">
            <columns>
                <TableColumn fx:id="idColumn" maxWidth="60.0" minWidth="60.0" prefWidth="60.0" style="-fx-alignment: CENTER-RIGHT;" text="%invoice.nr" />
                <TableColumn fx:id="invoiceDateColumn" maxWidth="120.0" minWidth="100.0" prefWidth="110.0" style="-fx-alignment: CENTER;" text="%invoice.date" />
                <TableColumn fx:id="invoiceNrColumn" minWidth="120.0" prefWidth="150.0" text="%invoice.number" />
                <TableColumn fx:id="companyIdColumn" maxWidth="80.0" minWidth="60.0" prefWidth="70.0" style="-fx-alignment: CENTER;" text="%invoice.company.id" />
                <TableColumn fx:id="companyNameColumn" minWidth="150.0" prefWidth="200.0" text="%invoice.company.des" />
                <TableColumn fx:id="invoiceDesColumn" minWidth="200.0" prefWidth="350.0" text="%invoice.des" />
                <TableColumn fx:id="invoiceAmountColumn" minWidth="100.0" prefWidth="120.0" style="-fx-alignment: CENTER-RIGHT; -fx-font-weight: bold;" text="%invoice.amount" />
                <TableColumn fx:id="pkColumn" maxWidth="100.0" minWidth="80.0" prefWidth="90.0" style="-fx-alignment: CENTER;" text="%invoice.bookkeeping" />
            </columns>
            <BorderPane.margin>
                <Insets bottom="10.0" left="15.0" right="15.0" top="15.0" />
            </BorderPane.margin>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>
    </center>

    <bottom>
        <VBox>
            <children>
                <Separator />
                <HBox alignment="CENTER_LEFT" spacing="10.0" style="-fx-background-color: #f8f9fa;">
                    <children>
                        <Button mnemonicParsing="false" onAction="#addInvoiceOnAction" prefWidth="100.0" styleClass="button-success" text="%partner.table.add" />
                        <Button mnemonicParsing="false" onAction="#editInvoiceOnAction" prefWidth="100.0" text="%partner.table.edit" />

                        <Separator orientation="VERTICAL" />

                        <Button mnemonicParsing="false" onAction="#deleteInvoiceOnAction" prefWidth="100.0" styleClass="button-danger" text="%partner.table.delete" />

                        <Region HBox.hgrow="ALWAYS" />

                        <Button mnemonicParsing="false" onAction="#printCompanyOnAction" prefWidth="110.0" styleClass="button-info" text="%partner.table.print" />
                    </children>
                    <padding>
                        <Insets bottom="12.0" left="20.0" right="20.0" top="12.0" />
                    </padding>
                </HBox>
            </children>
        </VBox>
    </bottom>
</BorderPane>